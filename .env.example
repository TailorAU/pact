# Source — example environment variables
#
# Copy this file to `.env.local` for local dev. None of the values below
# are secrets in their own right — they're documentation of which env vars
# the app reads.  Real secrets live in GitHub Actions secrets (production)
# or your local `.env.local` (never committed).
#
# See `sites/source/docs/` for full operational context.

# ─── Database (required) ──────────────────────────────────────────────
# Azure PostgreSQL Flexible Server in `australiaeast`. TLS required.
# Connection-string format documented in `docs/SOVEREIGNTY.md`.
DATABASE_URL=postgres://REDACTED:REDACTED@REDACTED/source

# ─── Admin / cron auth (required) ─────────────────────────────────────
# Single shared secret used as both the admin gate (X-Admin-Key) and the
# cron-secret. See `docs/AUDIT.md` § Admin authentication.
ADMIN_SECRET=
CRON_SECRET=

# ─── Legislation upstreams (optional, required for QLD parser) ────────
# QLD legislation API basic-auth credentials.  See `docs/SOVEREIGNTY.md`
# § Cross-border egress audit.
QLD_LEGISLATION_USERNAME=
QLD_LEGISLATION_PASSWORD=

# ─── Cache / rate-limit (optional) ────────────────────────────────────
# Azure Cache for Redis. When unset, both fall back to in-memory
# (rate-limit) and pass-through (cache).  See `docs/PERFORMANCE.md`
# § Redis — Azure Cache for Redis.
AZURE_REDIS_HOSTNAME=
AZURE_REDIS_PASSWORD=

# ─── LLM (optional, required for /api/scenarios/match LLM fallback) ───
# Azure OpenAI key for `oai-tailor-app-prod` (`australiaeast`).
AZURE_OPENAI_KEY=

# ─── Affiliate tags (optional) ────────────────────────────────────────
# Used by /api/grocery/* and /api/best-price/* affiliate-link rewrites.
AMAZON_AFFILIATE_TAG=
CF_COLES_TAG=
CF_WOOLWORTHS_TAG=
CF_CHEMIST_TAG=
CF_KMART_TAG=
EBAY_CAMPAIGN_ID=

# ─── Observability (optional) ─────────────────────────────────────────
# Azure Application Insights connection string. When unset,
# `instrumentation.ts` no-ops and structured-JSON logging on stdout is
# the only telemetry path. See `docs/OBSERVABILITY.md`.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Surfaced into the OTel resource attributes + the /api/health response.
SOURCE_VERSION=dev
AZURE_REGION=australiaeast

# ─── Cloudflare origin lock-down (optional, required after WS3 cutover) ──
# When Cloudflare is in front of source.tailor.au, a Transform Rule on
# the Cloudflare zone injects `x-origin-secret: <value>` into every
# proxied request.  The proxy at `src/proxy.ts` validates the header
# against this env var and 403s direct-to-origin hits that miss it.
#
# Forward-compatible: when this var is unset (local dev, PR previews,
# pre-cutover) the proxy allows all requests.  Same code, every env.
#
# Generate a fresh value with `openssl rand -hex 32`.  Knox-action: set
# this as both an ACA env var (via cd-source.yml) AND a Cloudflare
# Transform Rule header value.  See `docs/CDN.md` § Knox-action checklist.
ORIGIN_SHARED_SECRET=

# ─── Google Maps (build-time only) ────────────────────────────────────
# Public, used in client-side `<Script>` to render maps on landing pages.
# Subject to Google's own quota + referrer restrictions; not a secret.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
